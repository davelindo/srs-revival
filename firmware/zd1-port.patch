--- /dev/null
+++ b/module/os/apps/zd1-audio/src/sony_output.rs
@@ -0,0 +1,159 @@
+//! Sony's AV2 line-out framing and the two output mutes. The receiver holds
+//! the ALSA device exclusively for the lifetime of this guard.
+use crate::{device::PERIOD, speaker::Speaker};
+use alsa::pcm::{PCM, State};
+use dm870::{DevMem, Mmio, gpio};
+use std::time::{Duration, Instant};
+
+const KIND: u32 = 0xe000_a008;
+const SYNC: u32 = 0xe000_a808;
+const DATA: u32 = 1 << 8;
+const CLOCK: u32 = 1 << 10;
+const SELECT: u32 = 1 << 11;
+const MUTE: u32 = 1 << 16;
+const PINS: u32 = DATA | CLOCK | SELECT | MUTE;
+
+pub(super) struct SonyOutput {
+    bus: DevMem,
+    speaker: Speaker,
+    direction: u32,
+    latch: u32,
+    old_framing: Option<u32>,
+}
+
+fn error(reason: &'static str) -> alsa::Error {
+    alsa::Error::new(reason, nix::libc::EIO)
+}
+
+pub(super) fn is_sony() -> bool {
+    zd1_sys::OsRelease::read("/usr/lib/os-release").get("ID") == "sony-x7"
+}
+
+impl SonyOutput {
+    pub fn open(pcm: &PCM, speaker: &Speaker, current: &dyn Fn() -> bool) -> Result<Option<Self>, alsa::Error> {
+        if !is_sony() {
+            return Ok(None);
+        }
+        let info = pcm.info()?;
+        if info.get_card() != 0 || info.get_device() != 0 {
+            return Ok(None);
+        }
+        if speaker.yielded() || !speaker.audio_on() {
+            return Err(error("Sony source grant pending"));
+        }
+        let mut bus = DevMem::open().map_err(|_| error("open Sony audio registers"))?;
+        bus.read32(KIND).map_err(|_| error("map Sony AV2"))?;
+        let direction = bus.r32(gpio::BASE + gpio::reg::RELEASE);
+        let latch = bus.r32(gpio::BASE + gpio::reg::LOW);
+        let mut out = Self { bus, speaker: speaker.clone(), direction, latch, old_framing: None };
+        out.pins(gpio::reg::HIGH, MUTE | SELECT | CLOCK);
+        out.pins(gpio::reg::DRIVE, PINS);
+        out.control(0x2c)?;
+        let silence = [0i32; PERIOD * 2];
+        let io = pcm.io_i32()?;
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let mut clock_started = None;
+        loop {
+            if !current() || !out.granted() || Instant::now() >= deadline {
+                return Err(error("Sony stream ended, source revoked or AV2 clock unavailable"));
+            }
+            io.writei(&silence)?;
+            if pcm.state() != State::Running {
+                continue;
+            }
+            let kind = out.bus.r32(KIND);
+            match (out.old_framing, kind & 0x3ff) {
+                (None, 0x19 | 0x29) => {
+                    out.old_framing = Some(kind & 0x30);
+                    out.bus.w32(KIND, (kind & !0x30) | 0x10);
+                }
+                (Some(_), 0x19) => {}
+                _ => return Err(error("unexpected Sony AV2 format")),
+            }
+            if out.bus.r32(SYNC) & 1 == 0 {
+                clock_started = None;
+                continue;
+            }
+            if clock_started.get_or_insert_with(Instant::now).elapsed() >= Duration::from_secs(2) {
+                break;
+            }
+        }
+        if !current() || !out.granted() || out.bus.r32(KIND) & 0x3ff != 0x19 {
+            return Err(error("Sony stream, grant or framing changed during clock lead-in"));
+        }
+        out.control(0x2d)?;
+        out.pins(gpio::reg::LOW, MUTE);
+        out.check()?;
+        tracing::info!("Sony AV2 synchronized, GPIO16 low, HWCom 0x2d");
+        Ok(Some(out))
+    }
+
+    fn granted(&self) -> bool {
+        self.speaker.audio_on() && !self.speaker.yielded()
+    }
+
+    pub fn check(&mut self) -> Result<(), alsa::Error> {
+        if self.granted()
+            && self.bus.r32(KIND) & 0x3ff == 0x19
+            && self.bus.r32(SYNC) & 1 != 0
+            && self.bus.r32(gpio::BASE + gpio::reg::HIGH) & MUTE == 0
+        {
+            Ok(())
+        } else {
+            self.pins(gpio::reg::HIGH, MUTE);
+            Err(error("Sony output lost grant, framing, sync or unmute"))
+        }
+    }
+
+    fn pins(&mut self, register: u32, mask: u32) {
+        self.bus.w32(gpio::BASE + register, mask);
+    }
+
+    fn control(&mut self, byte: u8) -> Result<(), alsa::Error> {
+        // KnOS 0x60327414, active-low select and MSB first. Hold the edge
+        // without a scheduler tick per bit on this 100 Hz kernel.
+        let delay = || {
+            let start = Instant::now();
+            while start.elapsed() < Duration::from_millis(1) {
+                std::hint::spin_loop();
+            }
+        };
+        self.pins(gpio::reg::LOW, SELECT);
+        delay();
+        let mut wire = 0;
+        for bit in (0..8).rev() {
+            self.pins(gpio::reg::LOW, CLOCK);
+            self.pins(if byte & (1 << bit) == 0 { gpio::reg::LOW } else { gpio::reg::HIGH }, DATA);
+            delay();
+            self.pins(gpio::reg::HIGH, CLOCK);
+            delay();
+            let pads = self.bus.r32(gpio::BASE + gpio::reg::HIGH);
+            if pads & (CLOCK | SELECT) != CLOCK {
+                return Err(error("Sony HWCom clock/select"));
+            }
+            wire = (wire << 1) | u8::from(pads & DATA != 0);
+        }
+        self.pins(gpio::reg::HIGH, SELECT);
+        if wire != byte {
+            return Err(error("Sony HWCom data"));
+        }
+        Ok(())
+    }
+}
+
+impl Drop for SonyOutput {
+    fn drop(&mut self) {
+        self.pins(gpio::reg::HIGH, MUTE);
+        if let Err(err) = self.control(0x2c) {
+            tracing::warn!(%err, "Sony hardware mute");
+        }
+        if let Some(old) = self.old_framing {
+            let kind = self.bus.r32(KIND);
+            self.bus.w32(KIND, (kind & !0x30) | old);
+        }
+        self.pins(gpio::reg::RELEASE, self.direction & PINS);
+        self.pins(gpio::reg::HIGH, self.latch & PINS);
+        self.pins(gpio::reg::LOW, !self.latch & PINS);
+        self.pins(gpio::reg::DRIVE, !self.direction & PINS);
+    }
+}
