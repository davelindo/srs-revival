diff --git a/module/boot/src/bootlog.rs b/module/boot/src/bootlog.rs
new file mode 100644
--- /dev/null
+++ b/module/boot/src/bootlog.rs
@@ -0,0 +1,104 @@
+//! Transmit-only breadcrumbs before the kernel owns the MAC. Both callers run with the D-cache off.
+use crate::{Board, Link};
+use core::ptr::{addr_of_mut, read_volatile, write_volatile};
+use dm870::Mmio;
+use dm870::clocks::{Gate, Gates, Pll, PllSetting, tgen};
+use dm870::gpio::{Level, Pin, gpio};
+use dm870::timers::timers;
+
+const MAC: u32 = 0xe001_7000;
+const NCR: u32 = MAC;
+const NCFGR: u32 = MAC + 0x04;
+const TSR: u32 = MAC + 0x14;
+const TBQP: u32 = MAC + 0x1c;
+const IDR: u32 = MAC + 0x2c;
+const USED: u32 = 1 << 31;
+const TX_ENABLE: u32 = 1 << 3;
+const TX_START: u32 = 1 << 9;
+
+// Pinned in the relocated stub's reserved SDRAM. Never lend Linux a pointer to its own working memory.
+#[repr(C, align(32))]
+struct Tx {
+    descriptor: [u32; 2],
+    frame: [u8; 96],
+}
+static mut TX: Tx = Tx { descriptor: [0; 2], frame: [0; 96] };
+
+fn drain() {
+    unsafe { core::arch::asm!("mcr p15, 0, {0}, c7, c10, 4", in(reg) 0u32, options(nostack)) };
+}
+
+fn send(link: &mut Link<Board>, message: &[u8]) {
+    let m = link.mmio();
+    let lo = m.r32(MAC + 0x98).to_le_bytes();
+    let hi = m.r32(MAC + 0x9c).to_le_bytes();
+    let mut source = [lo[0], lo[1], lo[2], lo[3], hi[0], hi[1]];
+    if source == [0; 6] || source[0] & 1 != 0 {
+        source = [0x02, 0x5a, 0xd1, 0, 0, 1];
+    }
+    let mut frame = [0u8; 96];
+    frame[..6].fill(0xff);
+    frame[6..12].copy_from_slice(&source);
+    frame[12..14].copy_from_slice(&0x0800u16.to_be_bytes());
+    let udp_len = 8 + message.len() as u16;
+    frame[14] = 0x45;
+    frame[16..18].copy_from_slice(&(20 + udp_len).to_be_bytes());
+    frame[22] = 1;
+    frame[23] = 17;
+    frame[30..34].fill(0xff); // 0.0.0.0 -> 255.255.255.255, before address assignment
+    let mut sum: u32 = frame[14..34].as_chunks::<2>().0.iter().map(|&word| u16::from_be_bytes(word) as u32).sum();
+    while sum > 0xffff {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    frame[24..26].copy_from_slice(&(!(sum as u16)).to_be_bytes());
+    frame[34..36].copy_from_slice(&6666u16.to_be_bytes());
+    frame[36..38].copy_from_slice(&6666u16.to_be_bytes());
+    frame[38..40].copy_from_slice(&udp_len.to_be_bytes());
+    frame[42..42 + message.len()].copy_from_slice(message); // optional IPv4 UDP checksum stays zero
+    let len = (42 + message.len()).max(60);
+    m.w32(NCR, 0);
+    m.w32(TSR, 0x3f);
+    unsafe {
+        let data = addr_of_mut!(TX.frame).cast::<u8>();
+        let desc = addr_of_mut!(TX.descriptor).cast::<u32>();
+        core::ptr::copy_nonoverlapping(frame.as_ptr(), data, len);
+        write_volatile(desc, data as u32);
+        write_volatile(desc.add(1), (1 << 30) | (1 << 15) | len as u32); // wrap, last, length
+        drain();
+        m.w32(TBQP, desc as u32);
+        m.w32(NCR, TX_ENABLE);
+        m.w32(NCR, TX_ENABLE | TX_START);
+        let start = timers(m).now();
+        while timers(m).us_since(start) < 10_000 {
+            if read_volatile(desc.add(1)) & USED != 0 && m.r32(TSR) & 0x20 != 0 {
+                break;
+            }
+        }
+    }
+    m.w32(NCR, 0);
+    m.w32(TBQP, 0);
+}
+
+pub fn start(link: &mut Link<Board>) {
+    let m = link.mmio();
+    tgen(m).enable(Gates::of(&[Gate::ETHERNET]));
+    if tgen(m).pll(Pll::AV1) != PllSetting::AV1_PHY {
+        tgen(m).program(Pll::AV1, PllSetting::AV1_PHY);
+    }
+    gpio(m).drive(Pin::NresetEth, Level::High);
+    m.w32(NCR, 0);
+    m.w32(IDR, 0x3fff);
+    // Fixed 100 Mb/s, full duplex for the diagnostic transmission. PHY negotiation is not observed here.
+    m.w32(NCFGR, 0x803);
+    let start = timers(m).now();
+    for deadline in [0, 250_000, 750_000, 1_500_000, 2_500_000] {
+        while timers(link.mmio()).us_since(start) < deadline {
+            link.poll();
+        }
+        send(link, b"X7BOOT1 STUB\n");
+    }
+}
+
+pub fn handoff(link: &mut Link<Board>) {
+    send(link, b"X7BOOT1 HANDOFF\n");
+}
