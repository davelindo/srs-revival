@@ -0,0 +1,67 @@
+//! The same Sony endpoint used by Linux, polled before the kernel starts.
+//! This stage keeps the controller's startup handshake pending and preserves HCR recovery access. The
+//! Sony controller does not select our Linux system slots.
+use dm870::{
+    Mmio,
+    gpio::{Level, gpio},
+    timers::timers,
+};
+use x7_protocol::Kind;
+use x7_registers::Registers;
+use x7_transport::{READY, REQUEST, Transport};
+
+pub struct Link<M: Mmio> {
+    transport: Transport<M>,
+    registers: Registers,
+}
+
+impl<M: Mmio> Link<M> {
+    pub fn new(bus: M) -> Self {
+        let mut registers = Registers::new();
+        registers.set_fixed(0x28, [0, 0]);
+        registers.set_fixed(0x29, [0x20, 0x20]);
+        Self { transport: Transport::new(bus), registers }
+    }
+
+    pub fn mmio(&mut self) -> &mut M {
+        self.transport.bus()
+    }
+
+    pub fn set_value(&mut self, register: u8, value: &[u8]) {
+        // Boot identities are always <=20 bytes; no allocation or truncation.
+        if self.registers.set_variable(register, value).is_ok() {
+            let _ = self.registers.notify(Kind::ReadVariable, register, value);
+        }
+    }
+
+    pub fn set_status(&mut self, status: u16) {
+        let value = status.to_be_bytes();
+        self.registers.set_fixed(0x11, value);
+        let _ = self.registers.notify(Kind::ReadFixed, 0x11, &value);
+    }
+
+    pub fn poll(&mut self) {
+        self.transport.service(&mut self.registers);
+        while self.registers.pop_write().is_some() {}
+    }
+
+    pub fn bl2_requested(&self) -> bool {
+        self.registers.fixed(0x28).is_some_and(|bytes| bytes[0] == 0x21)
+    }
+
+    pub fn release_request_line(&mut self) {
+        self.transport.abort();
+        gpio(self.mmio()).drive(REQUEST, Level::Low);
+        gpio(self.mmio()).drive(READY, Level::Low);
+    }
+
+    pub fn reboot_to_bl2(&mut self) -> ! {
+        self.registers.set_fixed(0x29, [0x20, 0x20]);
+        let _ = self.registers.notify(Kind::ReadFixed, 0x29, &[0x20, 0x20]);
+        let start = timers(self.mmio()).now();
+        while timers(self.mmio()).us_since(start) < 500_000 {
+            self.poll();
+        }
+        dm870::reset_into_bl2(self.mmio())
+    }
+}
