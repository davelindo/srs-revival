+use std::ffi::{CString, c_char, c_int};
+use std::os::unix::ffi::OsStrExt;
+
+unsafe extern "C" {
+    fn zd1_prof_start();
+    fn zd1_prof_stop(path: *const c_char) -> c_int;
+}
+
+/// Sample CPU from process start through a graceful return from its entry point.
+pub struct CpuProfile(CString);
+
+impl CpuProfile {
+    pub fn start() -> Option<Self> {
+        let path = std::env::var_os("ZD1_CPU_PROFILE")?;
+        let path = CString::new(path.as_bytes()).ok()?;
+        unsafe { zd1_prof_start() };
+        Some(Self(path))
+    }
+}
+
+impl Drop for CpuProfile {
+    fn drop(&mut self) {
+        let samples = unsafe { zd1_prof_stop(self.0.as_ptr()) };
+        if samples < 0 {
+            eprintln!("Could not write CPU profile: {}", self.0.to_string_lossy());
+        } else {
+            eprintln!("Wrote {samples} CPU samples to {}", self.0.to_string_lossy());
+        }
+    }
+}
