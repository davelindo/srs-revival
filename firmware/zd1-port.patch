@@ -0,0 +1,80 @@
+//! Send the initial kernel ring over the wired interface once it is usable. syslog action 3 preserves the ring.
+use std::io;
+use std::net::{Ipv4Addr, UdpSocket};
+use std::os::fd::AsRawFd;
+use std::thread;
+use std::time::{Duration, Instant};
+
+const CHUNK_BYTES: usize = 960;
+const PORT: u16 = 6666;
+
+fn ethernet() -> io::Result<UdpSocket> {
+    let socket = UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0))?;
+    let name = b"eth0\0";
+    let rc = unsafe {
+        libc::setsockopt(
+            socket.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_BINDTODEVICE,
+            name.as_ptr().cast(),
+            name.len() as libc::socklen_t,
+        )
+    };
+    if rc < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    socket.set_broadcast(true)?;
+    socket.set_nonblocking(true)?;
+    Ok(socket)
+}
+
+fn broadcast(socket: &UdpSocket, id: u32, log: &[u8]) -> io::Result<()> {
+    for (index, chunk) in log.chunks(CHUNK_BYTES).enumerate() {
+        let mut packet = format!("X7BOOT1 DMESG {id} {} {}\n", index * CHUNK_BYTES, log.len()).into_bytes();
+        packet.extend_from_slice(chunk);
+        socket.send_to(&packet, (Ipv4Addr::BROADCAST, PORT))?;
+        // This MAC has a small TX queue. Leave room for the boot DHCP exchange.
+        thread::sleep(Duration::from_millis(10));
+    }
+    Ok(())
+}
+
+fn run() {
+    let start = Instant::now();
+    let mut socket = None;
+    let mut buffer = vec![0u8; 65536];
+    let mut previous = Vec::new();
+    let mut id = 0;
+    let mut sent = None;
+    while start.elapsed() < Duration::from_secs(120) {
+        let n = unsafe { libc::klogctl(3, buffer.as_mut_ptr().cast(), buffer.len() as i32) };
+        if n > 0 {
+            let log = &buffer[..n as usize];
+            if previous != log {
+                id += 1;
+                previous.clear();
+                previous.extend_from_slice(log);
+                sent = None;
+            }
+            if sent.is_none_or(|when: Instant| when.elapsed() >= Duration::from_secs(5)) {
+                if socket.is_none() {
+                    socket = ethernet().ok();
+                }
+                if let Some(s) = &socket {
+                    if broadcast(s, id, log).is_ok() {
+                        sent = Some(Instant::now());
+                    } else {
+                        socket = None;
+                    }
+                }
+            }
+        }
+        thread::sleep(Duration::from_millis(500));
+    }
+}
+
+pub fn start() {
+    if let Err(error) = thread::Builder::new().name("bootlog".into()).stack_size(64 * 1024).spawn(run) {
+        super::say(&format!("bootlog: {error}"));
+    }
+}
