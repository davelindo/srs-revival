+//! Module-owned boot selection. Sony's controller never sees Linux slots.
+//! Persist the attempted trial before switching roots; a reset then selects
+//! the confirmed system, or recovery. Confirmation is an explicit owner action.
+use crate::{STAMP, Slot};
+use std::{fs, os::unix::process::CommandExt, path::Path, process::Command};
+
+const STATE: &str = "/data/zd1/boot-state";
+
+/// Per-unit public login keys and a generated web credential. Existing owner
+/// changes always take precedence over the immutable provisioning bundle.
+pub fn provision() -> Result<(), String> {
+    let destination = "/data/zd1/management";
+    fs::create_dir_all(destination).map_err(|e| e.to_string())?;
+    for name in ["authorized_keys", "web-password"] {
+        let source = format!("/usr/share/x7/provisioning/{name}");
+        let target = format!("{destination}/{name}");
+        if !Path::new(&target).exists() && Path::new(&source).exists() {
+            let value = fs::read_to_string(&source).map_err(|e| e.to_string())?;
+            if value.len() > 8192 {
+                return Err("provisioning file exceeds 8 KiB".into());
+            }
+            zd1_sys::write_private(&target, &value).map_err(|e| e.to_string())?;
+        }
+    }
+    Ok(())
+}
+
+/// First-time owner operation from recovery. The running RAM-backed /data stays
+/// available until reboot, including the credentials used for this session.
+pub fn initialize_data() -> Result<(), String> {
+    if zd1_sys::OsRelease::read("/etc/os-release").get("VARIANT_ID") != "rescue" {
+        return Err("initialize-data requires wired recovery".into());
+    }
+    let _lock = crate::lock(true).ok_or("could not lock storage")?;
+    let layout = fs::read_to_string("/proc/mtd").map_err(|e| e.to_string())?;
+    for (name, size) in [("vendor", 64u32), ("system-a", 24), ("system-b", 24), ("data", 16)] {
+        if !layout.lines().any(|line| {
+            line.split('"').nth(1) == Some(name)
+                && line.split_whitespace().nth(1).and_then(|s| u32::from_str_radix(s, 16).ok()) == Some(size << 20)
+        }) {
+            return Err("unexpected Sony NAND layout".into());
+        }
+    }
+    if Path::new("/data/.zd1-data").is_file() {
+        return Ok(());
+    }
+    let number = crate::mtd("data").ok_or("data partition unavailable")?;
+    let block = format!("/dev/mtdblock{number}");
+    let target = "/run/x7-data-setup";
+    fs::create_dir_all(target).map_err(|e| e.to_string())?;
+    // A completed request can be retried before reboot without erasing it again.
+    if crate::mount(&block, target, true).is_ok() {
+        let initialized = Path::new(target).join(".zd1-data").is_file();
+        zd1_sys::umount(target);
+        if initialized {
+            return Ok(());
+        }
+    }
+    let mounts = fs::read_to_string("/proc/mounts").map_err(|e| e.to_string())?;
+    if mounts.lines().any(|line| {
+        let source = line.split_whitespace().next();
+        source == Some(block.as_str()) || source == Some("mtd:data")
+    }) {
+        return Err("data partition is still mounted".into());
+    }
+    crate::erase(number)?;
+    crate::mount(&block, target, false)?;
+    let result = zd1_sys::write_private(&format!("{target}/.zd1-data"), "");
+    let unmounted = unsafe { libc::umount(zd1_sys::cstr(target).as_ptr()) };
+    if unmounted != 0 {
+        return Err(std::io::Error::last_os_error().to_string());
+    }
+    result.map_err(|e| e.to_string())
+}
+
+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]
+struct State {
+    good: Option<Slot>,
+    trial: Option<Slot>,
+    attempted: bool,
+}
+
+impl State {
+    fn parse(text: &str) -> Result<Self, String> {
+        let mut words = text.split_whitespace();
+        let (Some("X7BOOT1"), Some(good), Some(trial), Some(attempted), None) =
+            (words.next(), words.next(), words.next(), words.next(), words.next())
+        else {
+            return Err("invalid local boot state".into());
+        };
+        let slot = |word: &str| {
+            if word == "-" { Ok(None) } else { Slot::parse(word).map(Some).ok_or("invalid local boot slot") }
+        };
+        Ok(Self {
+            good: slot(good)?,
+            trial: slot(trial)?,
+            attempted: match attempted {
+                "0" => false,
+                "1" => true,
+                _ => return Err("invalid boot attempt".into()),
+            },
+        })
+    }
+    fn text(self) -> String {
+        format!(
+            "X7BOOT1 {} {} {}\n",
+            self.good.map_or("-", Slot::name),
+            self.trial.map_or("-", Slot::name),
+            u8::from(self.attempted)
+        )
+    }
+    fn next(&mut self) -> Option<Slot> {
+        if let Some(trial) = self.trial
+            && !self.attempted
+        {
+            self.attempted = true;
+            return Some(trial);
+        }
+        self.trial = None;
+        self.attempted = false;
+        self.good
+    }
+}
+
+fn load() -> Result<State, String> {
+    match fs::read_to_string(STATE) {
+        Ok(text) if text.len() <= 64 => State::parse(&text),
+        Ok(_) => Err("local boot state exceeds 64 bytes".into()),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(State::default()),
+        Err(error) => Err(error.to_string()),
+    }
+}
+
+pub(super) fn require_persistent_data() -> Result<(), String> {
+    if Path::new("/data/.zd1-data").is_file() { Ok(()) } else { Err("persistent data is unavailable".into()) }
+}
+
+fn save(state: State) -> Result<(), String> {
+    require_persistent_data()?;
+    zd1_sys::write_private(STATE, &state.text()).map_err(|e| e.to_string())?;
+    unsafe {
+        libc::sync();
+    }
+    Ok(())
+}
+
+pub(super) fn good() -> Result<Option<Slot>, String> {
+    Ok(load()?.good)
+}
+
+pub fn stage(slot: Slot) -> Result<(), String> {
+    if crate::stamp(slot).is_none() {
+        return Err("target slot has no complete system".into());
+    }
+    let _lock = crate::lock(true).ok_or("could not lock storage")?;
+    let mut state = load()?;
+    if state.good == Some(slot) {
+        return Err("target is already the confirmed system".into());
+    }
+    state.trial = Some(slot);
+    state.attempted = false;
+    save(state)
+}
+
+pub fn confirm() -> Result<(), String> {
+    let _lock = crate::lock(true).ok_or("could not lock storage")?;
+    let running = crate::boot().running.ok_or("recovery has no running slot to confirm")?;
+    let mut state = load()?;
+    if state.trial != Some(running) || !state.attempted {
+        return Err("the running system is not an attempted trial".into());
+    }
+    state.good = Some(running);
+    state.trial = None;
+    state.attempted = false;
+    save(state)
+}
+
+/// Called by PID 1 after early mounts, before any daemon. Returns to the
+/// retained recovery when selection, validation or execution fails.
+pub fn enter() -> Result<(), String> {
+    let mut state = load()?;
+    let previous = state;
+    let chosen = state.next();
+    if state != previous {
+        save(state)?;
+    }
+    let Some(slot) = chosen else {
+        return Ok(());
+    };
+    // Clear a spent trial, or mark this attempt, durably before root execution.
+    let number = crate::mtd(slot.partition()).ok_or("system partition is unavailable")?;
+    let root = "/mnt/system";
+    fs::create_dir_all(root).map_err(|e| e.to_string())?;
+    zd1_sys::mount(&format!("/dev/mtdblock{number}"), root, "jffs2", libc::MS_RDONLY, "").map_err(|e| e.to_string())?;
+    if fs::read_to_string(format!("{root}/{STAMP}")).is_err() || !Path::new(&format!("{root}/sbin/init")).exists() {
+        zd1_sys::umount(root);
+        return Err("selected system has no completed stamp or init".into());
+    }
+    eprintln!("[x7-boot] slot {}, confirmed {}", slot.name(), state.good.map_or("none", Slot::name));
+    // switch_root frees the RAM root. Unmount its auxiliary filesystems first;
+    // the new init creates them anew. Its static /dev/console is in the archive.
+    for path in ["/data", "/dev/pts", "/dev", "/sys", "/proc", "/run", "/tmp", "/var"] {
+        zd1_sys::umount(path);
+        // An inherited console fd may keep /dev busy. Detach the old mount
+        // now; switch_root replaces those descriptors before the new init.
+        let path = std::ffi::CString::new(path).map_err(|e| e.to_string())?;
+        unsafe {
+            libc::umount2(path.as_ptr(), libc::MNT_DETACH);
+        }
+    }
+    let error = Command::new("/bin/busybox")
+        .args(["switch_root", "-c", "/dev/console", root, "/sbin/init"])
+        .env("SONY_X7_SLOT", slot.name())
+        .exec();
+    Err(format!("switch_root failed: {error}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn interrupted_trial_returns_to_the_confirmed_system() {
+        let mut state = State { good: Some(Slot::A), trial: Some(Slot::B), attempted: false };
+        assert_eq!(state.next(), Some(Slot::B));
+        let mut after_reset = State::parse(&state.text()).unwrap();
+        assert_eq!(after_reset.next(), Some(Slot::A));
+        assert_eq!(after_reset.trial, None);
+    }
+    #[test]
+    fn first_install_returns_to_recovery_without_confirmation() {
+        let mut state = State { trial: Some(Slot::A), ..State::default() };
+        assert_eq!(state.next(), Some(Slot::A));
+        assert_eq!(state.next(), None);
+        assert!(State::parse("X7BOOT1 a b 9").is_err());
+    }
+}
