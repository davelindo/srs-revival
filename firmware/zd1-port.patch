+/// Keep a warm-reset route to the vendor updater until Linux management starts.
+pub fn arm_boot_recovery(m: &mut impl Mmio) {
+    mailbox::request_bl2(m);
+    timers::timers(m).arm_boot_watchdog();
+}
+
+pub fn complete_boot_recovery(m: &mut impl Mmio) -> bool {
+    if mailbox::bl2_requested(m) && timers::timers(m).disarm_boot_watchdog() {
+        m.w32(mailbox::BASE, 0);
+        return true;
+    }
+    false
+}
